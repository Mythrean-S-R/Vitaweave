{
  "expo": {
    "name": "VitaWeave",
    "slug": "vitaweave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assests/icon.png",
    "scheme": "vitaweave",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitaweave.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "VitaWeave uses the camera for telemedicine video consultations.",
        "NSMicrophoneUsageDescription": "VitaWeave uses the microphone for telemedicine calls and voice health input.",
        "NSSpeechRecognitionUsageDescription": "VitaWeave uses speech recognition for hands-free health data entry.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assests/icon.png",
        "backgroundColor": "#0891b2"
      },
      "package": "com.vitaweave.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assests/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-speech-recognition",
      "expo-secure-store",
      "expo-dev-client",
      "@morrowdigital/watermelondb-expo-plugin",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "VitaWeave needs camera access for telemedicine consultations.",
          "microphonePermission": "VitaWeave needs microphone access for telemedicine and voice input.",
          "recordAudioAndroid": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "vitaweave",
          "project": "vitaweave-mobile"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assests/icon.png",
          "color": "#0891b2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "privacyPolicyUrl": "https://vitaweave.app/privacy"
    },
    "owner": "vitaweave"
  }
}
