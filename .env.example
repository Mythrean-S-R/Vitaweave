# VitaWeave Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ======================================
# REQUIRED: Google Cloud Firebase / Firestore
# ======================================
# Get these from Google Cloud Console / Firebase Console
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-firebase-project.appspot.com"

# ======================================
# REQUIRED: Supabase Configuration
# ======================================
# Get these from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ======================================
# REQUIRED: Google Gemini AI & Multimodal Scanning
# ======================================
# All AI and Multimodal scanning use Google Gemini API keys exclusively
# Get this from Google AI Studio: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY="your-gemini-api-key-here"
EXPO_PUBLIC_GEMINI_MODEL="gemini-2.5-flash"
EXPO_PUBLIC_GEMMA_MODEL="medgemma-2b"

# ======================================
# REQUIRED: Agora Video Calling (App ID is public; certificate stays on server)
# ======================================
EXPO_PUBLIC_AGORA_APP_ID="your-agora-app-id-here"

# Legacy client token - not needed when using agora-token edge function
# EXPO_PUBLIC_AGORA_TOKEN=""

# ======================================
# EDGE FUNCTIONS (set in Supabase Dashboard → Edge Functions → Secrets)
# ======================================
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash
# AGORA_APP_ID=your-agora-app-id
# AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Use Supabase edge proxy for Gemini (recommended for production)
EXPO_PUBLIC_USE_EDGE_PROXY="true"

# ======================================
# REQUIRED: Sentry Error Monitoring
# ======================================
# Get this from Sentry: https://sentry.io
EXPO_PUBLIC_SENTRY_DSN="https://your-sentry-dsn-here"
EXPO_PUBLIC_APP_VERSION="1.0.0"

# ======================================
# OPTIONAL: Development Settings
# ======================================
# Set to "true" to enable debug logging
DEBUG="false"

# Environment (development, staging, production)
NODE_ENV="development"

# Set to "true" to enable skip-login / demo bypass (local/dev only)
# Production builds (NODE_ENV=production) always ignore this and keep demo off
EXPO_PUBLIC_DEV_MODE="false"

# Custom API endpoints (if using self-hosted services)
# CUSTOM_API_BASE_URL="https://your-api-server.com"
# CUSTOM_WS_URL="wss://your-websocket-server.com"

# ======================================
# SECURITY NOTES
# ======================================
# 1. NEVER commit this .env file to version control
# 2. Keep API keys secure and rotate them regularly
# 3. Use different keys for development and production
# 4. Monitor API usage and costs
# 5. Implement rate limiting in production

# ======================================
# QUICK SETUP GUIDE
# ======================================
# 1. Supabase: Create project → Settings → API → copy URL & anon key
# 2. Gemini: Go to AI Studio → Create API key → copy key
# 3. Firecrawl: Sign up → Dashboard → Get API key
# 4. Agora: Create project → Get App ID → Generate token
# 5. Sentry: Create project → Get DSN
# 6. Save this file as .env (not .env.example)
# 7. Run: npm install && npx expo start


# ========== REQUIRED ==========
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...your-anon-key"
# India data localization - create project in Mumbai (ap-south-1)
EXPO_PUBLIC_SUPABASE_REGION="ap-south-1"

# ABDM: mock allowed in development only. Production never uses mock OTP.
# Preview/production EAS sets EXPO_PUBLIC_ABDM_MODE=live; without BASE_URL, ABDM is disabled.
EXPO_PUBLIC_ABDM_MODE="mock"
# EXPO_PUBLIC_ABDM_BASE_URL="https://abdm-sandbox.example.gov.in"

# Agora - public App ID only (certificate stays on Supabase edge)
EXPO_PUBLIC_AGORA_APP_ID="your-32-char-alphanumeric-agora-app-id"

# ========== PRODUCTION FLAGS ==========
EXPO_PUBLIC_USE_EDGE_PROXY="true"
EXPO_PUBLIC_DEV_MODE="false"
NODE_ENV="production"
DEBUG="false"

# ========== SENTRY ==========
EXPO_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
EXPO_PUBLIC_APP_VERSION="1.0.0"

# ========== GEMINI (client - optional when edge proxy is true) ==========
# With EXPO_PUBLIC_USE_EDGE_PROXY=true, AI uses gemini-proxy edge function.
# You can leave a placeholder or omit; edge secret GEMINI_API_KEY is what matters.
EXPO_PUBLIC_GEMINI_API_KEY="not-used-when-proxy-enabled"
EXPO_PUBLIC_GEMINI_MODEL="gemini-2.5-flash"

# ========== OPTIONAL ==========
EXPO_PUBLIC_FIRECRAWL_API_KEY=""